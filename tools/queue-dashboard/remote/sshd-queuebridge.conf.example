# Include this only after validating the effective sshd configuration.
# The bridge account is not an interactive shell and cannot forward TCP listeners.
Match User queuebridge
    AuthenticationMethods publickey
    PasswordAuthentication no
    KbdInteractiveAuthentication no
    # Some OpenSSH versions also gate remote Unix sockets on this option.
    # PermitListen none below still denies TCP listeners.
    AllowTcpForwarding remote
    AllowStreamLocalForwarding remote
    StreamLocalBindMask 0117
    StreamLocalBindUnlink yes
    PermitOpen none
    PermitListen none
    GatewayPorts no
    AllowAgentForwarding no
    X11Forwarding no
    PermitTTY no
    PermitUserRC no
    PermitTunnel no
    ForceCommand /usr/sbin/nologin
