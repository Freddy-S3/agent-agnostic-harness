#!/bin/sh
#
# Enforces the AGENTS.md rule "Never add an agent as a commit co-author".
#
# The rule lived only in prose, so nothing stopped a tool from writing the
# trailer anyway; ten commits carried one before the history rewrite stripped
# them. Per "Conventions need an enforcing mechanism", the rule now lives in a
# code path that runs on every commit.
#
# Behaviour: rewrite, do not reject. A blocked commit teaches the author to pass
# --no-verify; a silently corrected one just stays correct. The hook prints what
# it removed so the edit is never invisible. A message with nothing to strip is
# left byte-for-byte alone.
#
# The match pattern is written as an awk regex constant rather than passed with
# -v: awk expands escape sequences in a -v assignment, which turns \[bot\] into
# the character class [bot] and matches almost every address. Keep it literal.
#
# Installed by install.ps1, which points core.hooksPath at this directory.

set -e

msg_file="$1"
[ -n "$msg_file" ] || exit 0
[ -f "$msg_file" ] || exit 0

keep_file="$msg_file.harness-keep"
cut_file="$msg_file.harness-cut"

rm -f "$keep_file" "$cut_file"

# Vendor domains and bot markers are the reliable signals. The bare product names
# are a fallback for tools committing from a personal address, bounded by
# non-letters so a human name is never caught by a substring ("Claudia" must not
# match "claude", "exAMPle" must not match a product token).
awk -v keep="$keep_file" -v cut="$cut_file" '
	{
		low = tolower($0)
		if (low ~ /^[ \t]*co-authored-by:[ \t]/ &&
		    low ~ /(@anthropic\.com|@openai\.com|@cursor\.(com|sh)|\[bot\]|(^|[^a-z])(claude|copilot|codex|devin|aider|windsurf|chatgpt|gemini|cody|tabnine)([^a-z]|$))/) {
			print $0 > cut
			next
		}
		print $0 > keep
	}
' "$msg_file"

if [ ! -s "$cut_file" ]; then
	rm -f "$keep_file" "$cut_file"
	exit 0
fi

[ -f "$keep_file" ] || : >"$keep_file"

# Removing the last trailer can leave the message ending in blank lines. Drop
# trailing blanks so the result looks hand-written.
awk '
	{ lines[NR] = $0 }
	END {
		last = 0
		for (i = 1; i <= NR; i++) {
			if (lines[i] ~ /[^ \t]/) { last = i }
		}
		for (i = 1; i <= last; i++) { print lines[i] }
	}
' "$keep_file" >"$msg_file"

echo "commit-msg: removed agent co-author trailer(s), per AGENTS.md:" >&2
sed 's/^/  /' "$cut_file" >&2

rm -f "$keep_file" "$cut_file"

exit 0
